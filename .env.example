# --- Lead notification emails (every new lead is emailed to all that are set) ---
EMAIL_1=replace-me-1@example.com
EMAIL_2=replace-me-2@example.com
EMAIL_3=replace-me-3@example.com

# --- SMTP used to send those emails (e.g. Gmail app password, Zoho, SendGrid SMTP, Brevo) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: defaults to SMTP_USER
SMTP_FROM="211 OVERSEAS Website <no-reply@example.com>"

# --- Admin panel (/admin) ---
# Complex protected password for leads dashboard (defaults to 211Overseas#GlobalAdmin$2026!)
ADMIN_PASSWORD=211Overseas#GlobalAdmin$2026!
# Optional: Random string used to sign the admin session cookie (defaults to ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=

# --- Lead storage (needed on Vercel, where the filesystem is read-only/ephemeral) ---
# Any Upstash Redis / Vercel KV database. Without these, leads fall back to a local .data/leads.json file
# (fine for local development only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Firebase Realtime Database (Web Client Config) ---
# Copy these from your Firebase Console -> Project Settings -> General -> Your apps -> Web app
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Optional: if your Realtime Database rules require an auth secret / token
FIREBASE_DATABASE_SECRET=

# --- Google Sheets Live Sync (Real-time Lead Webhook) ---
# Deploy a Google Apps Script as Web App on your Google Sheet and paste its URL here
GOOGLE_SHEETS_WEBHOOK_URL=

# --- Contact page ---
# Office address shown on the contact page and used for the embedded Google Map
NEXT_PUBLIC_OFFICE_ADDRESS=ADDRESS
