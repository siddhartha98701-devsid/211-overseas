# --- Lead notification emails (every new lead is emailed to all that are set) ---
EMAIL_1=replace-me-1@example.com
EMAIL_2=replace-me-2@example.com
EMAIL_3=replace-me-3@example.com

# --- SMTP used to send those emails (e.g. Gmail app password, Zoho, SendGrid SMTP, Brevo) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: defaults to SMTP_USER
SMTP_FROM="211 OVERSEAS Website <no-reply@example.com>"

# --- Admin panel (/admin) ---
ADMIN_PASSWORD=choose-a-long-random-password
# Random string used to sign the admin session cookie (defaults to ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=

# --- Lead storage (needed on Vercel, where the filesystem is read-only/ephemeral) ---
# Any Upstash Redis / Vercel KV database. Without these, leads fall back to a local .data/leads.json file
# (fine for local development only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Contact page ---
# Office address shown on the contact page and used for the embedded Google Map
NEXT_PUBLIC_OFFICE_ADDRESS=ADDRESS
